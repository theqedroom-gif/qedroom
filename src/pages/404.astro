---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="We couldn't find that page.">
  <div class="wrap section">
    <h1>We couldn't find that page</h1>
    <p class="lead">The link may be old, or the address may have a typo. Let's get you back to the lessons.</p>
    <div class="actions"><a class="btn btn--primary" href="/lessons/">Go to lessons</a></div>
  </div>
</Base>
